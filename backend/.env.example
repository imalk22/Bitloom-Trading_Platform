# Copy to backend/.env and fill in. NEVER commit the real file — it is gitignored.

# ── Admin accounts ───────────────────────────────────────────────────────────
# ADMIN_MAIN_* is the owner account: the only one that can open the Oversight
# tab and review what the other admins credited/debited. The 2nd and 3rd are
# optional — leave blank to disable that account entirely.
ADMIN_MAIN_USER=
ADMIN_MAIN_PASS=
ADMIN_2_USER=
ADMIN_2_PASS=
ADMIN_3_USER=
ADMIN_3_PASS=

# ── Firebase Admin ───────────────────────────────────────────────────────────
# Preferred locally: drop serviceAccountKey.json in this folder instead.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Server ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
FRONTEND_ORIGIN=http://localhost:5173
PORT=3001
