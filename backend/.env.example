# Copy to backend/.env and fill in. NEVER commit the real file — it is gitignored.

# ── Admin accounts (main + limited agents) ───────────────────────────────────
# ADMIN_MAIN_* = full access (oversight, all chats, any customer).
#   Login with USERNAME or EMAIL.
# ADMIN_2 … ADMIN_18 = limited: only customers who signed up with their CODE,
# and only those customers' live chats.
#
# CODE = short unique referral / invite code customers MUST enter at signup.
# Leave PASS / EMAIL blank in this example — set real values only in .env

ADMIN_MAIN_USER=
ADMIN_MAIN_PASS=
ADMIN_MAIN_CODE=
ADMIN_MAIN_EMAIL=

ADMIN_2_USER=
ADMIN_2_PASS=
ADMIN_2_CODE=

ADMIN_3_USER=
ADMIN_3_PASS=
ADMIN_3_CODE=

ADMIN_4_USER=
ADMIN_4_PASS=
ADMIN_4_CODE=

ADMIN_5_USER=
ADMIN_5_PASS=
ADMIN_5_CODE=

ADMIN_6_USER=
ADMIN_6_PASS=
ADMIN_6_CODE=

ADMIN_7_USER=
ADMIN_7_PASS=
ADMIN_7_CODE=

ADMIN_8_USER=
ADMIN_8_PASS=
ADMIN_8_CODE=

ADMIN_9_USER=
ADMIN_9_PASS=
ADMIN_9_CODE=

ADMIN_10_USER=
ADMIN_10_PASS=
ADMIN_10_CODE=

ADMIN_11_USER=
ADMIN_11_PASS=
ADMIN_11_CODE=

ADMIN_12_USER=
ADMIN_12_PASS=
ADMIN_12_CODE=

ADMIN_13_USER=
ADMIN_13_PASS=
ADMIN_13_CODE=

ADMIN_14_USER=
ADMIN_14_PASS=
ADMIN_14_CODE=

ADMIN_15_USER=
ADMIN_15_PASS=
ADMIN_15_CODE=

ADMIN_16_USER=
ADMIN_16_PASS=
ADMIN_16_CODE=

ADMIN_17_USER=
ADMIN_17_PASS=
ADMIN_17_CODE=

ADMIN_18_USER=
ADMIN_18_PASS=
ADMIN_18_CODE=

# ── Firebase Admin ───────────────────────────────────────────────────────────
# Preferred locally: drop serviceAccountKey.json in this folder instead.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Server ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
FRONTEND_ORIGIN=http://localhost:5173
PORT=3001
